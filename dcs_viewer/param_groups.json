  "analysis_model": {
    "description": "高炉炉前开/堵口作业智能化辅助模型 — 基于GBDT-MPC-PID三级协同架构",
    "dimensions": [
      {
        "name": "遥控器指令分析",
        "indicators": ["选择", "正反转", "挂钩/脱钩", "冲击开/关"],
        "model_inputs": ["开口机选择", "转钎正传/反转", "挂钩/脱钩", "冲击开/关"],
        "purpose": "识别操作指令模式，为GBDT提供离散指令特征"
      },
      {
        "name": "控制比例阀分析",
        "indicators": ["回转进/退", "小车前进/后退"],
        "model_inputs": ["回转进/回转退", "小车前进/小车后退"],
        "purpose": "分析比例阀动作时序，为MPC提供执行层参数"
      },
      {
        "name": "压力-位置关联分析",
        "indicators": ["回转压力/位置", "推进压力/位置", "挂钩位置/倾动压力"],
        "model_inputs": ["回转位置", "回转压力", "挂钩位置", "倾动压力", "推进位置", "推进压力", "回转回油", "倾动回油压力"],
        "purpose": "建立力-位移关系模型，检测设备机械状态异常"
      },
      {
        "name": "钻进与冲击系统分析",
        "indicators": ["冲击压力", "转钎压力", "送进压力", "穿透判定"],
        "model_inputs": ["送给回压力", "转钎回油压力", "转钎压力", "冲击压力", "冲击回压力"],
        "purpose": "分析开口钻进过程中的压力特征，用于钻透智能判断"
      },
      {
        "name": "东西侧对比分析",
        "indicators": ["东西差异度", "利用率对比", "压力曲线一致性"],
        "data_sources": ["东/西开口机同参数对比"],
        "purpose": "识别单侧设备老化或异常"
      }
    ]
  }
